# SQLite file path (relative to the prisma/ directory)
DATABASE_URL="file:./dev.db"

# HTTP port the API listens on
PORT=4000

# Allowed CORS origin(s). "*" = allow all, or comma-separated list e.g. http://localhost:5173
CORS_ORIGIN=*

NODE_ENV=development

# Use a long, random value in production
JWT_SECRET=replace-with-a-long-random-secret

# jsonwebtoken duration, e.g. 7d, 12h, or 30m
JWT_EXPIRES_IN=7d
