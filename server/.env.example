# Prisma 6: session/direct endpoint, strict certificate validation, bounded pool.
# sslcert must be an absolute path. URL-encode the database password.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/postgres?sslmode=require&sslaccept=strict&sslcert=/absolute/path/supabase-ca.crt&connection_limit=5"
NODE_EXTRA_CA_CERTS=/absolute/path/supabase-ca.crt
PORT=4000
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173
JWT_SECRET=replace-with-at-least-32-random-characters
JWT_EXPIRES_IN=7d
SUPABASE_URL=https://PROJECT.supabase.co
SUPABASE_SECRET_KEY=sb_secret_REPLACE_SERVER_ONLY
SUPABASE_STORAGE_BUCKET=user-files
STORAGE_TIMEOUT_MS=30000
# Render: serve React and API from one origin to preserve SameSite=Lax cookies.
# STATIC_DIR=../client/dist

# Migration-only configuration; never put this in React or deployment build args.
# MIGRATION_SOURCE_DB=/absolute/path/verified-backup.db
# MIGRATION_ORIGINAL_DB=/absolute/path/server/prisma/dev.db
# MIGRATION_TARGET_DB=postgresql://USER:PASSWORD@HOST:5432/postgres
# Confirm these only after the actual operator checks; do not leave commit flags on.
# MIGRATION_PASSWORD_ROTATED=yes
# MIGRATION_WRITES_STOPPED=yes
# MIGRATION_COMMIT=yes
# STORAGE_MIGRATION_COMMIT=yes
