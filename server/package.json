{
  "name": "pseudo-fs-server",
  "version": "1.0.0",
  "private": true,
  "description": "Storage App \u2014 Express, Prisma PostgreSQL and private Supabase Storage",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "prisma generate && tsc",
    "start": "node dist/server.js",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:deploy": "prisma migrate deploy",
    "prisma:studio": "prisma studio",
    "typecheck": "tsc --noEmit",
    "lint": "tsc --noEmit",
    "test": "node --import tsx --test test/validation.test.ts test/migration.test.ts",
    "test:integration": "node scripts/run-integration-tests.mjs",
    "migrate:sqlite": "node scripts/run-migration.mjs sqlite",
    "migrate:storage": "node scripts/run-migration.mjs storage",
    "migrate:verify": "node scripts/run-migration.mjs verify",
    "migrate:preflight": "node scripts/run-migration.mjs preflight"
  },
  "prisma": {
    "schema": "prisma/postgres/schema.prisma"
  },
  "dependencies": {
    "@prisma/client": "6.19.3",
    "@supabase/supabase-js": "^2.119.0",
    "bcryptjs": "^3.0.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^5.1.0",
    "express-rate-limit": "^8.7.3",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.1.1",
    "pg": "^8.23.1",
    "swagger-ui-express": "^5.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.1.0",
    "@types/node": "^24.13.2",
    "@types/swagger-ui-express": "^4.1.8",
    "playwright": "^1.65.0",
    "prisma": "6.19.3",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  },
  "engines": {
    "node": ">=24.13.1 <25"
  },
  "overrides": {
    "@prisma/config": {
      "deepmerge-ts": "^8.0.0"
    }
  }
}
